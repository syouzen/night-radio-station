{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Night Radio Station",
  "version": "0.1.0",
  "identifier": "com.syouzen.nightradiostation",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Night Radio Station",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
